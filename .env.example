# Passcode for signing in. Leave unset only for local development.
APP_PASSWORD=
# Long random string; signs the login cookie and encrypts Meta tokens.
APP_SECRET=

# Storage (Supabase). Run supabase/schema.sql in the project first.
SUPABASE_URL=
SUPABASE_ANON_KEY=
TRACKER_DB_KEY=

# Optional
# Lets Vercel Cron run Meta Autopilot daily (any long random string).
CRON_SECRET=
META_API_VERSION=v23.0

# Boss RDR landing page (/rdr). All optional.
# Forward each application to a webhook (Zapier, Make, CRM).
RDR_APPLY_WEBHOOK=
# Email each application through Resend.
RESEND_API_KEY=
RDR_NOTIFY_EMAIL=
RDR_NOTIFY_FROM=
